# Django Secret Key

DJANGO_SECRET_KEY=change-me-in-production

# Database (PostgreSQL in production)
DATABASE_URL=postgresql://user:pass@localhost:5432/fk_cesis_mms

# Invoice Ninja API
INVOICE_NINJA_BASE_URL=https://app.invoiceninja.com
INVOICE_NINJA_API_TOKEN=

# Billing auto-send (P6 invoice issue/send policy).
# When false, the nightly send job is a no-op — deploy, verify on one parent, then flip on.
BILLING_AUTOSEND_ENABLED=false
# Local-time hour for the nightly send sweep (offset from payment-sync at 3).
BILLING_SEND_DUE_HOUR=4

# Audit log retention (P7). Nightly prune deletes audit events older than this many days.
AUDIT_RETENTION_DAYS=730
# Local-time hour for the nightly audit prune (offset from billing 3/4).
AUDIT_PRUNE_HOUR=2

# P16-A signed PDF/.edoc maximum upload size (20 MiB by default).
SIGNED_ARTIFACT_MAX_BYTES=20971520

# VZD address autocomplete region/locality object codes, comma-separated.
# Example values must be replaced with confirmed production Cēsis-area VZD codes.
ADDRESS_AUTOCOMPLETE_REGION_CODES=
# Weekly VZD address import. Weekday uses Python convention: Monday=0, Sunday=6.
ADDRESS_IMPORT_WEEKDAY=6
ADDRESS_IMPORT_HOUR=1
ADDRESS_IMPORT_MAX_DROP_RATIO=0.50
ADDRESS_IMPORT_DOWNLOAD_TIMEOUT_SECONDS=30
# Optional URL overrides. Defaults are official data.gov.lv VARIS downloads.
ADDRESS_IMPORT_AW_NOVADS_URL=
ADDRESS_IMPORT_AW_PAGASTS_URL=
ADDRESS_IMPORT_AW_PILSETA_URL=
ADDRESS_IMPORT_AW_CIEMS_URL=
ADDRESS_IMPORT_AW_IELA_URL=
ADDRESS_IMPORT_AW_EKA_URL=
ADDRESS_IMPORT_AW_DZIV_URL=

# OCR service (optional)
# Set to "stub" for deterministic dummy extraction, or "tiny_idp" for real provider.
OCR_PROVIDER_MODE=stub

# tiny-IDP provider (required when OCR_PROVIDER_MODE=tiny_idp)
TINY_IDP_API_URL=
TINY_IDP_API_KEY=

# Fernet key for encrypting OCR payloads and summaries (required when OCR is enabled)
OCR_ENCRYPTION_KEY=

# Private storage
PRIVATE_STORAGE_CLASS=django_private_storage.storage.BaseStorage

# Magic-link auth
MAGIC_LINK_TTL_MINUTES=60
MAGIC_LINK_RATE_LIMIT_PER_MINUTE=5
SITE_URL=http://localhost:8000

# Agreement numbers sent to DocuSeal: {PREFIX}-{YEAR}-{SEQUENCE}
AGREEMENT_NUMBER_PREFIX=FKC

# Admin bootstrap (management command)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_USERNAME=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@your-domain.lv
EMAIL_HOST_PASSWORD=
EMAIL_HOST_USER=

# Analytics (P10). Keep disabled until privacy/GDPR setup is reviewed.
ANALYTICS_PROVIDER=stub
ANALYTICS_BROWSER_ENABLED=false
ANALYTICS_SERVER_ENABLED=false
ANALYTICS_DOMAIN=
ANALYTICS_SITE_ID=
ANALYTICS_API_URL=
ANALYTICS_API_KEY=
ANALYTICS_TIMEOUT_SECONDS=2
