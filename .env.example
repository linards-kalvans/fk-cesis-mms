# Django Secret Key

DJANGO_SECRET_KEY=change-me-in-production

# Database (PostgreSQL in production)
DATABASE_URL=postgresql://user:pass@localhost:5432/fk_cesis_mms

# Invoice Ninja API
INVOICE_NINJA_BASE_URL=https://app.invoiceninja.com
INVOICE_NINJA_API_TOKEN=

# OCR service (optional)
# Set to "stub" for deterministic dummy extraction, or "tiny_idp" for real provider.
OCR_PROVIDER_MODE=stub

# tiny-IDP provider (required when OCR_PROVIDER_MODE=tiny_idp)
TINY_IDP_API_URL=
TINY_IDP_API_KEY=

# Fernet key for encrypting OCR payloads and summaries (required when OCR is enabled)
OCR_ENCRYPTION_KEY=

# Private storage
PRIVATE_STORAGE_CLASS=django_private_storage.storage.BaseStorage

# Magic-link auth
MAGIC_LINK_TTL_MINUTES=60
MAGIC_LINK_RATE_LIMIT_PER_MINUTE=5
SITE_URL=http://localhost:8000

# Admin bootstrap (management command)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_USERNAME=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@your-domain.lv
EMAIL_HOST_PASSWORD=
EMAIL_HOST_USER
